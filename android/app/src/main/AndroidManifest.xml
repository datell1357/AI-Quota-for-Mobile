<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <application
    android:name=".AIQuotaApplication"
    android:allowBackup="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.AIQuota">
    <!-- AdMob SDK가 요구하는 앱 ID. 빠지면 앱이 시작 즉시 크래시한다.
         값은 local.properties의 aiquota.admobAppId, 없으면 Google 테스트 ID가 들어간다. -->
    <meta-data
      android:name="com.google.android.gms.ads.APPLICATION_ID"
      android:value="${admobAppId}" />
    <!-- 광고 SDK 초기화는 앱 화면이 보일 때만 한다. 백그라운드 수집·위젯 갱신으로 프로세스가
         떠 있는 동안 SDK가 스스로 초기화하지 않도록 자동 초기화를 끈다. -->
    <meta-data
      android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
      android:value="true" />
    <activity
      android:name=".providers.WebLoginActivity"
      android:exported="false" />
    <activity
      android:name=".providers.GlmWebLoginActivity"
      android:exported="false"
      android:process=":glm_webview" />
    <activity
      android:name=".providers.GlmApiKeyActivity"
      android:exported="false" />
    <activity
      android:name=".providers.GeminiCliLoopbackOAuthActivity"
      android:exported="true"
      android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:scheme="aiquota"
          android:host="provider"
          android:path="/gemini-oauth-complete" />
      </intent-filter>
    </activity>
    <activity
      android:name=".providers.AntigravityLoopbackOAuthActivity"
      android:exported="true"
      android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data
          android:scheme="aiquota"
          android:host="provider"
          android:path="/antigravity-oauth-complete" />
      </intent-filter>
    </activity>
    <activity
      android:name=".providers.GoogleAuthorizationActivity"
      android:exported="false" />
    <activity
      android:name="net.openid.appauth.RedirectUriReceiverActivity"
      android:exported="true"
      android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar" />
    <activity
      android:name=".widget.ProviderWidgetConfigureActivity"
      android:exported="true" />
    <activity
      android:name=".widget.DashboardWidgetConfigureActivity"
      android:exported="true" />
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTop">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service
      android:name=".providers.ProviderUsageCollectionService"
      android:exported="false" />
    <service
      android:name=".providers.ProviderBackgroundRefreshService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="usage_monitor" />
    </service>
    <service
      android:name=".providers.GlmIsolatedWebSessionService"
      android:exported="false"
      android:process=":glm_webview" />
    <receiver
      android:name=".widget.WidgetManualRefreshReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="u.sage.widget.action.REFRESH" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".providers.ProviderRefreshReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="com.aiquota.mobile.action.REFRESH" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".update.AppUpdatedReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".widget.AIQuotaUnifiedGlanceWidgetReceiver"
      android:label="@string/widget_label_unified"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ai_quota_widget_large" />
    </receiver>
    <receiver
      android:name=".widget.AIQuotaCircularWidgetProvider"
      android:label="@string/widget_label_2x2"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ai_quota_widget_circular" />
    </receiver>
    <receiver
      android:name=".widget.ProviderUsageWidgetProvider"
      android:label="@string/widget_label_provider"
      android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ai_quota_widget_provider" />
    </receiver>
  </application>
</manifest>
