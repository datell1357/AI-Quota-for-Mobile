<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="12dp"
  android:paddingTop="10dp"
  android:paddingEnd="12dp"
  android:paddingBottom="10dp">

  <TextView
    android:id="@+id/notification_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="AI Usage"
    android:textColor="#111827"
    android:textSize="14sp"
    android:textStyle="bold" />

  <LinearLayout
    android:id="@+id/notification_row_0"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/notification_icon_0"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@null" />

    <ProgressBar
      android:id="@+id/notification_progress_0"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="0dp"
      android:layout_height="8dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:indeterminate="false"
      android:max="100" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/notification_row_1"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/notification_icon_1"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@null" />

    <ProgressBar
      android:id="@+id/notification_progress_1"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="0dp"
      android:layout_height="8dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:indeterminate="false"
      android:max="100" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/notification_row_2"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/notification_icon_2"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@null" />

    <ProgressBar
      android:id="@+id/notification_progress_2"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="0dp"
      android:layout_height="8dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:indeterminate="false"
      android:max="100" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/notification_row_3"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:id="@+id/notification_icon_3"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:contentDescription="@null" />

    <ProgressBar
      android:id="@+id/notification_progress_3"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="0dp"
      android:layout_height="8dp"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:indeterminate="false"
      android:max="100" />
  </LinearLayout>
</LinearLayout>
