<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/dashboard_immediate_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background_macos_rounded">

  <LinearLayout
    android:id="@+id/dashboard_immediate_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
      android:id="@+id/dashboard_immediate_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="2"
      android:text="@string/widget_no_data"
      android:textColor="@color/widget_caption"
      android:textSize="12sp"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/dashboard_immediate_row_0"
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:orientation="vertical"
      android:paddingEnd="26dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/dashboard_immediate_icon_0"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:contentDescription="@null"
          android:scaleType="fitCenter" />

        <TextView
          android:id="@+id/dashboard_immediate_name_0"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/widget_caption"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/dashboard_immediate_remaining_0"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/widget_caption"
          android:textSize="10sp" />
      </LinearLayout>

      <ProgressBar
        android:id="@+id/dashboard_immediate_progress_0"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="24dp"
        android:minHeight="0dp"
        android:progressDrawable="@drawable/widget_provider_progress" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/dashboard_immediate_row_1"
      android:layout_width="match_parent"
      android:layout_height="44dp"
