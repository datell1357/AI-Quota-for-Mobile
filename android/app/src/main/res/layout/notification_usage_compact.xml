<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="12dp"
  android:paddingTop="8dp"
  android:paddingEnd="12dp"
  android:paddingBottom="8dp">

  <ImageView
    android:id="@+id/notification_compact_icon"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:contentDescription="@null"
    android:src="@drawable/ic_stat_ai_usage" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/notification_compact_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="AI Usage"
      android:textColor="#111827"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/notification_compact_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="Claude 100% | Codex 90%\nGemini 100% | Copilot 100%"
      android:textColor="#111827"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
