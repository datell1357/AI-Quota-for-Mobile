<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_bg"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/widget_header_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">
        <ImageView
            android:id="@+id/widget_service_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/glance_colorPrimary"
            android:contentDescription="Service Icon"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/glance_colorOnSurface"
            android:ellipsize="end"
            android:id="@+id/widget_service_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="6dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/glance_colorOnSurfaceVariant"
            android:id="@+id/widget_last_updated"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <FrameLayout
            android:id="@+id/widget_refresh_container"
            android:background="@drawable/widget_refresh_ripple"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <ImageView
                android:id="@+id/widget_refresh_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/refresh_24px"
                android:scaleType="center"
                android:tint="@color/glance_colorOnSurface"
                android:contentDescription="Refresh"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/widget_refresh_progress"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/glance_colorOnSurface"/>
        </FrameLayout>
    </LinearLayout>
    <ListView
        android:id="@+id/widget_limit_list"
        android:paddingBottom="4dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="0dp"/>
</LinearLayout>
